# Arcjet — abuse protection, AI guards, rate limiting (https://app.arcjet.com)
# 1. Create account → Sites → Add site → copy key.
# 2. Paste below and restart `npm run dev`.
# Without a key the app still runs (Arcjet fails open) but the DB daily
# quota (17 uploads / 24h) is the only enforcement.
ARCJET_KEY=ajkey_yourkey

# Copy this file to .env.local and fill in your keys from the Clerk Dashboard
# (https://dashboard.clerk.com → your application → API Keys).

# Public key — safe to expose in the browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Secret key — server only, never commit
CLERK_SECRET_KEY=sk_test_...

# Custom auth page routes (must match the pages in app/(auth))
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where users land after signing in / signing up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Neon Postgres — pooled connection string from the Neon dashboard
# (Project → Connect → pooled). Required for saving users to the DB.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Inngest — local dev works without keys via `npx inngest-cli@latest dev`
# (app serves at /api/inngest). For Inngest Cloud, add signing + event keys:
# INNGEST_SIGNING_KEY=signkey-prod-...
# INNGEST_EVENT_KEY=...

# Storj S3-compatible — from Storj dashboard (Access → S3 credentials).
# Endpoint looks like https://gateway.storjshare.io (do NOT append bucket).
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_BUCKET=your-bucket-name
STORJ_ACCESS_KEY=...
STORJ_SECRET_KEY=...
# Optional: base URL for the ACTUAL public object URL returned after upload.
# Set this when the bucket/objects are public (or you expose Link Sharing / CDN).
# When unset, playbackUrl falls back to a signed GET URL (7-day expiry).
# STORJ_PUBLIC_URL=https://gateway.storjshare.io

# Deepgram — speech-to-text for AI analysis (`video/analysis.requested`).
# Get a key at https://console.deepgram.com → API Keys.
# DEEPGRAM_API_KEY=...

# Link downloader (YouTube/Twitch -> Storj) — Cobalt API instance.
# Self-host for production: https://github.com/imputnet/cobalt
#   - COBALT_API_URL: full endpoint, e.g. https://cobalt.yourdomain.com/
#     (public demo https://api.cobalt.tools is rate-limited — dev only).
#   - COBALT_API_KEY: optional, sent as `Authorization: Api-Key <key>`.
# COBALT_API_URL=https://api.cobalt.tools
# COBALT_API_KEY=...

# yt-dlp YouTube auth — fixes "Sign in to confirm you're not a bot".
# YouTube blocks cookie-less/server-IP yt-dlp; set ONE of these (file wins).
# Use a THROWAWAY YouTube account — downloader sessions get flagged.
#   - YTDLP_COOKIES_FILE: path to Netscape cookies.txt exported from a
#     logged-in browser ("Get cookies.txt LOCALLY" extension). Best for servers.
#   - YTDLP_COOKIES_FROM_BROWSER: e.g. chrome / edge / firefox. Needs that
#     browser installed + logged into YouTube on THIS machine (local dev).
# Optional tuning:
#   - YTDLP_EXTRACTOR_ARGS: override default "youtube:player_client=android,web,tv"
#   - YTDLP_SLEEP_REQUESTS: seconds between requests (default 1; 0 disables).
# Also keep yt-dlp fresh: python -m yt_dlp -U (stale builds get challenged more).
# YTDLP_COOKIES_FILE=/path/to/youtube-cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Gemini — viral-moment selection (`select-viral-moments` step).
# Get a key at https://aistudio.google.com/apikey (free tier works).
# GEMINI_API_KEY=...
# Optional overrides (defaults shown):
# GEMINI_MODEL=gemini-3.8-flash
# Retry transient Gemini overload (503/429/5xx) with exponential backoff:
# GEMINI_RETRIES=4 (total attempts; 1 = no retry)
# GEMINI_RETRY_BASE_MS=2000 (first backoff; doubles each attempt + jitter)
# SHORTS_COUNT=5
# SHORTS_MIN_SECONDS=30
# SHORTS_MAX_SECONDS=90
# SHORTS_TRANSCRIPT_CHARS=12000

